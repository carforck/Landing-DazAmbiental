# URL de la aplicación web del Apps Script vinculado al Sheet del cliente.
# Termina en /exec. Se lee solo en el servidor: nunca llega al navegador.
# Sin esta variable el flujo funciona igual y la fila queda en los logs.
GOOGLE_SHEETS_WEBHOOK_URL=

# Clave compartida con el Apps Script (propiedad TOKEN del script).
# La aplicación web queda abierta a cualquiera para que el servidor pueda
# escribir; esta clave es lo que impide que alguien con la URL meta filas.
GOOGLE_SHEETS_TOKEN=
